# ==========================================
# ☕ Smol Café Environment Variables Configuration
# ==========================================

# --- 1. Supabase Database & Auth (ap-south-1 Mumbai) ---
# [PUBLIC] Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [PUBLIC] Supabase Anonymous Client Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER ONLY - SECRET] Supabase Service Role Key (Admin / RLS Bypass)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- 2. Direct Device UPI Payment Configuration ---
# [PUBLIC] Merchant UPI VPA Address
NEXT_PUBLIC_UPI_ID=sanidhyadwivedi2004@okicici

# [PUBLIC] Merchant Contact Phone Number
NEXT_PUBLIC_UPI_NUMBER=+91 9305084332

# [PUBLIC] Merchant Display Name
NEXT_PUBLIC_UPI_NAME=smol café

# --- 3. Session & Security Credentials ---
# [SERVER ONLY - SECRET] Signed Session Cookie Secret Key
SESSION_SECRET=smol-cafe-secret-session-key-2026

# --- 4. System Observability & Monitoring ---
# [PUBLIC / SERVER] Sentry Error Monitoring DSN
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# [SERVER ONLY] Operational Health Alert Webhook URL
ALERT_WEBHOOK_URL=https://your-discord-or-slack-webhook-url
